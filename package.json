{
  "name": "apollo-engine",
  "version": "0.1.0",
  "description": "Apollo Game Engine",
  "author": "Apollo Game Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:audit": "node tools/ui-audit.mjs",
    "demo": "vite-node src/assembly/demo.run.ts",
    "net:demo": "vite-node src/net/lockstep.demo.ts",
    "bench": "vite-node src/bench/run-bench.ts",
    "build:cartridge": "tsc --noEmit && vite build --config vite.config.cartridge.ts",
    "build:cartridge:single": "VITE_SINGLEFILE=1 vite build --config vite.config.cartridge.ts",
    "pack:mac": "electron-builder --mac --config electron-builder.yml",
    "pack:win": "electron-builder --win --config electron-builder.yml",
    "dist": "python3 scripts/dist.py"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "cannon-es": "^0.20.0",
    "phaser": "^3.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "33.0.0",
    "electron-builder": "^25.0.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.0.5"
  }
}
