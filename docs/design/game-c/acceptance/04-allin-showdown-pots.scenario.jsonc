// GD-C 验收剧本 · ③all-in 摊牌·单一主池全额结算（gdd §3 边池·等栈全下=单层池·守恒）。
// 主角(座0=button)翻前全下 1000 → 五姨太 AI 逐个跟全下 → 六家等栈 all-in → 打到摊牌单一主池。
//
// 剧本作者手工核对（seed=42 hand#1·同 02 同牌·全下版）：六家各 1000 全下 → 池=6000（单层·无边池：等投入无切层）。
//   公共牌 K♦ 2♥ 10♣ 7♦ 2♠；座1(2♣ Q♠)=三条(三个2) 为六家最优 → **座1 独收 6000**。
//   守恒：won-total == showdown-pot == 6000（全部筹码在桌·无生灭）；主角(座0)两对负、栈清零。
// ⚠ 精确值钉死到 (seed 42 + M1 占位 AI)·M2 换 AI 须 GD 重派（REQ-ACCEPT 分工）。
// 注：等栈全下只出单层主池；**多层边池矩阵**见 05（跨手制造短栈·真三层切池）。
{
  "name": "六家等栈全下·单主池·三条独收6000（精确·seed42）",
  "game": "game-c",
  "seed": 42,
  "steps": [
    { "tick": 3 },
    { "expect": [ { "flag": "hero-turn", "eq": true } ] },
    // 全下：raise-to=主角 allInTo=栈 1000（button 翻前未投）。
    { "signal": "hero_act", "args": { "action": "raise", "to": 1000 } },
    { "expect": [
      { "flag": "allin-0", "eq": true },
      { "flag": "phase-betting", "eq": true }
    ] },
    { "tick": 40 },
    { "expect": [
      { "flag": "phase-showdown", "eq": true },
      { "flag": "allin-0", "eq": true },
      { "flag": "allin-1", "eq": true },         // 六家全 all-in（等栈）
      { "flag": "allin-5", "eq": true },
      { "res": "community-count", "eq": 5 },
      { "res": "winner-count", "eq": 1 },        // 单一主池唯一赢家
      { "sv": "winner-type", "eq": "三条" },      // 座1 三条最优
      { "res": "won-1", "eq": 6000 },            // 独收整池
      { "res": "won-0", "eq": 0 },               // 主角负
      { "res": "showdown-pot", "eq": 6000 },
      { "res": "won-total", "eq": 6000 },        // 守恒
      { "res": "stack-1", "eq": 6000 },          // 赢家收全场筹码
      { "res": "stack-0", "eq": 0 }              // 主角出清
    ] }
  ]
}
