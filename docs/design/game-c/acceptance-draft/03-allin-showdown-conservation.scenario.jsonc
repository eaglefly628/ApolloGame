// GD-C 验收剧本 · 主角全下 → 真实多方边池 + 摊牌 settle → 筹码守恒。
// 走到真实 settle 分池路径（比剧本 01 的弃牌路径更压边池），是 REQ-C-105（P0 边池蒸发）的 session 层哨兵：
//   若 potLayers/settle 漏筹码，摊牌后 chips_net ≠ 6000 → 剧本红。
// raise.to 给一个必 all-in 的大数（超栈由 betting-engine act→pay 钳到整栈；legalActions.max=全下位）。
{
  "name": "主角全下·边池摊牌守恒（P0 哨兵）",
  "game": "game-c",
  "seed": 20260717,
  "config": { "startStack": 1000, "smallBlind": 25, "bigBlind": 50 },
  "steps": [
    { "expect": [
      { "res": "chips_net", "eq": 6000 },
      { "sv": "phase", "eq": "betting" }
    ] },
    // 主角全下（to 远超栈 → 钳为整栈 all-in）→ session 自动跑 AI 应对 → 摊牌结算。
    { "signal": "hero_raise", "args": { "to": 100000 }, "by": "hero" },
    { "expect": [
      { "flag": "hero_allin", "eq": true },
      { "sv": "phase", "eq": "showdown" },
      // 核心：摊牌 settle 后全场筹码一分不漏、一分不涨（无典当）。
      { "res": "chips_net", "eq": 6000 },
      { "res": "pot", "eq": 0 }
    ] }
  ]
}
