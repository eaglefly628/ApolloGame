// GD-C 验收剧本 · 玩法闭环：主角弃牌 → session 自动打完 AI → 摊牌 → 下一手。
// 验 GDD §2 一手循环闭环 + 全程筹码守恒（无典当·6 人×1000=6000）。
// 断言只读世界机读态（adapter readWorld），守恒锚点放手间/showdown。
{
  "name": "主角弃牌一手·闭环推进与守恒",
  "game": "game-c",
  "seed": 20260717,
  "config": { "startStack": 1000, "smallBlind": 25, "bigBlind": 50 },
  "steps": [
    { "expect": [
      { "res": "chips_net", "eq": 6000 },
      { "sv": "phase", "eq": "betting" },
      { "res": "hand_no", "eq": 1 },
      { "res": "alive_count", "eq": 6 }
    ] },
    // 主角弃牌 → session.advance 自动跑五姨太 AI 直到摊牌（主角不再行动）。
    { "signal": "hero_fold", "by": "hero" },
    { "expect": [
      { "flag": "hero_folded", "eq": true },
      { "sv": "phase", "eq": "showdown" },
      { "res": "chips_net", "eq": 6000 }
    ] },
    // 摊牌屏「继续」→ 开第 2 手，筹码仍守恒（池已归赢家）。
    { "signal": "next_hand" },
    { "expect": [
      { "res": "hand_no", "eq": 2 },
      { "sv": "phase", "eq": "betting" },
      { "res": "chips_net", "eq": 6000 },
      { "res": "alive_count", "eq": 6 }
    ] }
  ]
}
