// GD-C 验收剧本 · 多手循环筹码不漏（REQ-C-105 P0 的真实 session 层哨兵）。
// 连打数手（主角每手弃牌·AI 自动打完），每手后断言 chips_net = 6000。
// 为什么这是 P0 哨兵：多手打下去 AI 会输到栈 < 盲注 → 下手缴盲短缴 all-in → 正是 P0
//   （大盲短缴 all-in + 弃牌 → 边池 refund 只取 live top → 未跟注差额蒸发）的触发条件。
//   若边池蒸发筹码，chips_net 会跌破 6000 → 剧本红。AI 自动典当续命注入的筹码由 chips_injected 吸收，
//   不污染 chips_net（故此探针能在真实多手局隔离出「蒸发」这一类 bug）。
{
  "name": "多手循环·筹码不漏（P0 边池蒸发哨兵）",
  "game": "game-c",
  "seed": 20260717,
  "config": { "startStack": 1000, "smallBlind": 25, "bigBlind": 50 },
  "steps": [
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 1 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 2 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 3 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 4 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 5 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 6 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 7 } ] },

    { "signal": "hero_fold", "by": "hero" },
    { "expect": [ { "res": "chips_net", "eq": 6000 } ] },
    { "signal": "next_hand" },
    { "expect": [ { "res": "chips_net", "eq": 6000 }, { "res": "hand_no", "eq": 8 } ] }
  ]
}
