{
  // GD 验收剧本 01 · 基础消色（自动同色连喷）。规则 gdd §2.2/2.3·数字与 walkthrough 一致。
  // 对抗目标：去同色过滤/launch 不触发 → remain-blue 不降。
  "name": "基础消色·自动同色连喷",
  "game": "game102",
  "seed": 20101,
  "config": { "cols": 5, "rows": 1, "palette": ["blue", "red"], "ammo": 5,
    "conveyorCap": 5, "burstCap": 10, "slots": 5, "beltSpeed": 95,
    "limit": { "kind": "moves", "n": 3 }, "goals": [{ "kind": "clear" }], "bitmap": ["000.1"] },
  "steps": [
    { "tick": 2 },
    { "signal": "tapSupply:blue" },
    // tick 预算 60 → 300（2026-09-28 主程修·**只动 tick·下面 expect 一个字没改**）：
    // 本剧本写于「直射」老设计；v2 把炮改成**绕环形轨道过位剥离**（moveSpeed 5·绕一圈约 200 tick·
    // 见 game102.walkthrough.test.ts 的 LOOP=200 与 step(560)），60 tick 炮还没绕到像素那儿。
    // 实测（探针）：62 tick 剩 3 格 · 122 剩 2 · **182 清空**（score 30）→ 取 300 留 65% 余量。
    // 放宽不会抖：本局停止条件是**结构性**的（ammo 5 > 蓝 3 格·清完无同色目标即静止·红格蓝炮永远打不到），
    // 不是靠时间卡点——所以多跑几拍结果不变。
    { "tick": 300 },
    { "expect": [
      { "res": "remain.blue", "eq": 0 },
      { "res": "remain.red", "eq": 1 },
      { "res": "remain.total", "eq": 1 },
      { "res": "score", "gte": 1 },
      { "sv": "flow", "eq": "playing" }
    ] }
  ]
}
