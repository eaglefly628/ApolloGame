  "knowledge": [
    {
      "id": "k-matching",
      "kind": "authenticity",
      "title": "号码匹配",
      "body": "老爷车的车架号、发动机号、变速箱号要是和出厂记录都对得上，行里叫「号码匹配」（matching numbers），是原厂原装的铁证。换过发动机的车，在藏家眼里就差了一大截。",
      "quiz": {
        "q": "「号码匹配」说的是哪几样对得上出厂记录？",
        "options": [
          "车架、发动机、变速箱号",
          "车牌和行驶证",
          "轮胎和轮毂"
        ],
        "answer": 0,
        "explain": "车架号、发动机号、变速箱号与出厂记录一致，才叫号码匹配。"
      },
      "xp": 5,
      "sources": [
        {
          "title": "收藏车评估通行标准（matching numbers）"
        }
      ],
      "review": {
        "status": "draft",
        "notes": "待老爷车顾问审校"
      }
    },
    {
      "id": "k-condition",
      "kind": "jargon",
      "title": "车况四级",
      "body": "国际收藏车圈常把车况分四级：1 级是能参加展评的展车，比新车还讲究；2 级优秀；3 级良好，能日常开；4 级一般，能开但毛病不少。买卖、估值都先报这个级别。",
      "xp": 3,
      "sources": [
        {
          "title": "收藏车车况分级（1–4 级通行口径）"
        }
      ],
      "review": {
        "status": "draft"
      }
    },
    {
      "id": "k-rust",
      "kind": "authenticity",
      "title": "先看锈",
      "body": "看老车别先看漆，先蹲下看门槛、底板、轮拱这些容易积水的地方有没有锈穿。漆面再漂亮，锈在底下就是大工程，行家看车第一眼往往是看车底。",
      "xp": 4,
      "sources": [
        {
          "title": "老爷车验车要点"
        }
      ],
      "review": {
        "status": "draft"
      }
    },
    {
      "id": "k-tire-date",
      "kind": "craft",
      "title": "轮胎的生日",
      "body": "轮胎侧面有一串 DOT 码，最后四位是生产的周和年，比如 2319 就是 2019 年第 23 周。老车常年开得少，轮胎看着新其实早老化了，看这四位就知道该不该换。",
      "quiz": {
        "q": "DOT 码最后四位是 0518，是哪年生产的？",
        "options": [
          "2018 年",
          "2005 年",
          "1805 年"
        ],
        "answer": 0,
        "explain": "前两位是第几周，后两位是年份：2018 年第 5 周。"
      },
      "xp": 4,
      "sources": [
        {
          "title": "轮胎 DOT 码标识规则"
        }
      ],
      "review": {
        "status": "draft"
      }
    },
    {
      "id": "k-paint",
      "kind": "craft",
      "title": "原厂漆色",
      "body": "很多老车在车身铭牌或出厂档案里记着原厂漆色号。修复时按原色号重喷的，比随意改色更受藏家看重；原厂老漆保存下来的，哪怕有些斑驳，也有人专门追。",
      "xp": 3,
      "sources": [
        {
          "title": "老爷车修复惯例"
        }
      ],
      "review": {
        "status": "draft"
      }
    },
    {
      "id": "k-original-part",
      "kind": "authenticity",
      "title": "原厂件和复刻件",
      "body": "仪表、方向盘、轮毂、车标这些零件，原厂老件和后来的复刻件价钱差得远。行家会看零件上的厂标、编号和做工，满世界找原厂件，是玩老爷车最费功夫的地方。",
      "xp": 3,
      "sources": [
        {
          "title": "老爷车零件寻访常识"
        }
      ],
      "review": {
        "status": "draft"
      }
    }
  ],
