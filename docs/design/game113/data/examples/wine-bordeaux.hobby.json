  "knowledge": [
    { "id": "k-1855", "kind": "craft", "title": "1855 分级",
      "body": "1855 年巴黎世博会前，波尔多按酒价给梅多克的酒庄排了五个等级。一级庄起初只有四家，1973 年木桐升上来凑成五家。这份名单一百多年几乎没动过，是波尔多最硬的出身证明。",
      "quiz": { "q": "1855 分级后，哪家酒庄是唯一升进一级庄的？", "options": ["木桐", "玛歌", "拉图"], "answer": 0,
                "explain": "木桐 1973 年升为一级庄，是这份名单唯一的一次升级。" },
      "xp": 4, "sources": [{ "title": "1855 波尔多列级酒庄分级（官方名单）" }],
      "review": { "status": "draft", "notes": "待侍酒师顾问审校" } },
    { "id": "k-mis-en-bouteille", "kind": "jargon", "title": "酒庄装瓶",
      "body": "「Mis en bouteille au château」意思是在酒庄里装瓶。有这行字，说明从葡萄到装瓶都在酒庄自己手里，不是运出去让酒商装的。看不到这行字的名庄酒，要多留个心眼。",
      "xp": 3, "sources": [{ "title": "法国葡萄酒酒标标注规定" }], "review": { "status": "draft" } },
    { "id": "k-ullage", "kind": "authenticity", "title": "瓶肩的酒液高度",
      "body": "老酒要看酒液降到哪儿。拍卖行分成瓶颈、瓶颈底、瓶肩上沿、高瓶肩、中瓶肩、低瓶肩几档。二十多年的酒到瓶肩上沿算正常；降到中瓶肩，说明它在谁家柜子里躺得不太舒服。",
      "quiz": { "q": "一瓶 20 多年的老酒，哪种液位最让人放心？", "options": ["瓶肩上沿", "中瓶肩", "低瓶肩"], "answer": 0,
                "explain": "年头长了液位略降正常，到中瓶肩以下说明密封或储存可能有问题。" },
      "xp": 5, "sources": [{ "title": "拍卖行葡萄酒液位（ullage）描述标准" }], "review": { "status": "draft" } },
    { "id": "k-vintage", "kind": "story", "title": "年份就是那年的天气",
      "body": "酒标上的年份是葡萄采收的那一年。波尔多靠天吃饭，同一个酒庄，好年份和差年份能差出好几倍的身价。行家点酒先问年份，再问酒庄。",
      "xp": 2, "sources": [{ "title": "波尔多年份概述" }], "review": { "status": "draft" } },
    { "id": "k-cork", "kind": "authenticity", "title": "木塞上的烙印",
      "body": "名庄的软木塞上会烙酒庄名和年份。开瓶后看木塞：字迹清楚、和酒标年份一致是好兆头；木塞上什么都没有，或者年份对不上，就得多问一句了。",
      "xp": 3, "sources": [{ "title": "名庄软木塞烙印惯例" }], "review": { "status": "draft" } }
  ],
