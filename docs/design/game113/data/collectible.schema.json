{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game113.hobby/1",
  "title": "Game113 爱好包（一门爱好 = 一个文件）",
  "description": "三层结构：① 核心最小集 item.{id,name,images,spots,cards,collect}（解释器唯一消费面）② 领域扩展 hobby.{fields,spotTypes,knowledge}（只加描述性数据，不加行为）③ 可选模块 hobby.modules（行为开关，引擎通用实现）。跨引用与 attrs 校验由 check.mjs 完成。说明见 collectible-spec.md。坐标 = 相对图片的归一化值（0..1，左上原点，y 向下）。 版本：卡片规范 v1.0（specVersion，规则见 collectible-spec.md §0.5）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specVersion",
    "id",
    "name",
    "category",
    "zone",
    "titles",
    "grading",
    "market",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "game113.hobby/1"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "卡片规范版本。1.x 内只做加法：老文件永远有效；主版本号变化需迁移脚本"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "category": {
      "$ref": "#/$defs/categoryId"
    },
    "ageRating": {
      "enum": [
        "all",
        "12+",
        "17+",
        "18+"
      ],
      "default": "all"
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 8,
          "description": "仓库里的分区名，如 酒窖 / 雪茄柜"
        },
        "coverKey": {
          "$ref": "#/$defs/assetKey"
        }
      }
    },
    "titles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "description": "学识称号阶梯，minXp 严格升序，第一档必须为 0",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minXp",
          "name"
        ],
        "properties": {
          "minXp": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "maxLength": 6
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "description": "③ 行为模块开关（全部爱好共用同一份引擎实现）。v1.0 只开放 quiz；compare 真仿对比 · process 工序 · breed 繁育 · grade 估品 为预留，引擎实现前 check.mjs 拒收。养护不是模块：由 careable 维度 + careItems 数据驱动",
      "items": {
        "enum": [
          "quiz",
          "compare",
          "process",
          "breed",
          "grade"
        ]
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 8,
      "default": [],
      "description": "② 领域字段字典：在 categories.json 的 全局 + 大类 字段之上追加，不得重定义已有 key",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dims",
        "tiers",
        "values"
      ],
      "description": "② 品相分级（owner 2026-09-28 流通性标准：有明确品相分级才适合做带等级的道具）。dims = 参与分级的 ordered enum 字段；tiers = 品级名，从低到高；藏品在 tier 里标自己的品级；values = 每档折合雅钱",
      "properties": {
        "dims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 4
          }
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "每个品级折合多少雅钱（与 tiers 一一对应、严格递增）；最高档须落在本爱好 market.priceBand 对应的 topValue 区间内（categories.json）。藏品的雅钱 = values[tier 的序号]"
        }
      }
    },
    "careItems": {
      "type": "array",
      "maxItems": 3,
      "default": [],
      "description": "本爱好的保养品（三消产出、用于养护）。没有可养维度的爱好（如红酒）可以为空：它的藏品不进三消棋盘",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "raises",
          "perStep"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string",
            "maxLength": 8
          },
          "iconKey": {
            "$ref": "#/$defs/assetKey"
          },
          "raises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/slug"
            },
            "description": "能提升的 careable 维度"
          },
          "perStep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "提升一档要用几个"
          }
        }
      }
    },
    "spotTypes": {
      "type": "array",
      "maxItems": 12,
      "default": [],
      "description": "② 领域门道模板：这门爱好里反复出现的标准看点（如红酒的 液位 / 酒标分级 / 木塞），指向领域知识卡",
      "items": {
        "$ref": "#/$defs/spotType"
      }
    },
    "knowledge": {
      "type": "array",
      "default": [],
      "description": "② 领域知识库：可被多件藏品复用的知识卡（同一张卡全局只加一次学识）",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liquidity",
        "channels",
        "priceBand"
      ],
      "description": "准入门槛（owner 2026-09-28 硬规则）：一门爱好的收藏物必须存在**合法的、能用钱买到的**真实市场（电商、二手、垂类平台、拍卖行、经纪均可；玩家买不买得起不影响）。没有市场的爱好不收录。本块为内部运营元数据，不在玩家界面显示，不写具体价格",
      "properties": {
        "liquidity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "流通性（1–5 均为准入合格，数值只决定开馆先后）：5 大众电商可搜可比价 · 4 垂类平台/二手活跃 · 3 专业市场/拍卖行常态成交 · 2 经纪或专场拍卖（名种马、老爷车）· 1 合法但零星成交"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 12
          },
          "minItems": 1
        },
        "entry": {
          "type": "string",
          "maxLength": 12,
          "description": "入门价位量级，如「几十元」"
        },
        "ceiling": {
          "type": "string",
          "maxLength": 12,
          "description": "上限价位量级"
        },
        "compliance": {
          "type": "string",
          "maxLength": 60,
          "description": "流通/销售合规备注"
        },
        "priceBand": {
          "enum": [
            "b1",
            "b2",
            "b3",
            "b4",
            "b5"
          ],
          "description": "本爱好最高品级的真实价位量级：b1 百元级 · b2 千元级 · b3 万元级 · b4 十万级 · b5 百万级以上（categories.json priceBands）"
        },
        "segmentBy": {
          "$ref": "#/$defs/slug",
          "description": "行情板块再按哪个 enum 字段细分（如核桃按品种）。板块 id = 爱好/字段值/品级；不写则 = 爱好/品级"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "categoryId": {
      "enum": [
        "aging",
        "mechanics",
        "craft",
        "living",
        "sensory",
        "pursuits"
      ],
      "description": "owner 五大类（按投入的核心资源）+ pursuits 待定补充类；定义见 categories.json"
    },
    "assetKey": {
      "type": "string",
      "pattern": "^g113\\.[a-z0-9.-]+$",
      "description": "资产台账 key（皮肤槽）。禁止写文件路径：图片与坐标强绑定，必须钉死到具体一张图"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "maxLength": 8
        },
        "type": {
          "enum": [
            "text",
            "number",
            "year",
            "enum",
            "multi",
            "bool"
          ],
          "description": "闭集：不支持嵌套对象"
        },
        "unit": {
          "type": "string",
          "maxLength": 6
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "maxLength": 12
          },
          "description": "enum / multi 必填"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "filter": {
          "type": "boolean",
          "default": false,
          "description": "在爱好馆里作为筛选项"
        },
        "ordered": {
          "type": "boolean",
          "default": false,
          "description": "仅 enum：options 按从低到高排列，可作为品相分级维度"
        },
        "careable": {
          "type": "boolean",
          "default": false,
          "description": "可养：保养品能把这个品相维度提升一档（仅限 grading.dims 里的 ordered enum 字段）"
        }
      }
    },
    "spotType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "cardId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "maxLength": 8
        },
        "cardId": {
          "$ref": "#/$defs/slug",
          "description": "指向 hobby.knowledge 里的卡"
        },
        "hint": {
          "type": "string",
          "maxLength": 20
        },
        "key": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "w",
        "h",
        "sha256",
        "source"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/assetKey"
        },
        "role": {
          "enum": [
            "main",
            "closeup",
            "compare"
          ],
          "default": "main"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|TBD)$",
          "description": "换图即换哈希 → 该图上的坐标全部作废、须重标"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "license",
            "credit"
          ],
          "properties": {
            "license": {
              "enum": [
                "CC0",
                "CC-BY",
                "CC-BY-SA",
                "licensed",
                "user-upload",
                "TBD"
              ]
            },
            "credit": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "x",
        "y",
        "r"
      ],
      "properties": {
        "kind": {
          "const": "circle"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "r": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.25,
          "description": "半径，相对图片宽度"
        }
      }
    },
    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "imageKey",
        "shape"
      ],
      "description": "写 type 则继承门道模板的 cardId/hint/key；也可不写 type、直接给 cardId（本件独有的门道）。二者至少其一",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "$ref": "#/$defs/slug"
        },
        "imageKey": {
          "$ref": "#/$defs/assetKey"
        },
        "shape": {
          "$ref": "#/$defs/circle"
        },
        "revealZoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 1
        },
        "closeupKey": {
          "$ref": "#/$defs/assetKey"
        },
        "hint": {
          "type": "string",
          "maxLength": 20
        },
        "cardId": {
          "$ref": "#/$defs/slug"
        },
        "note": {
          "type": "string",
          "maxLength": 60,
          "description": "本件在通用知识之外的一句补充（叠在领域卡下方显示）"
        },
        "key": {
          "type": "boolean"
        },
        "flaw": {
          "type": "boolean",
          "default": false,
          "description": "这是一处瑕疵（阴皮、锈、霉斑、冲线）。有瑕疵点的藏品会出现「找瑕疵」模式"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "body",
        "xp",
        "sources",
        "review"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "craft",
            "authenticity",
            "story",
            "jargon"
          ],
          "description": "门道 / 鉴别 / 典故 / 行话"
        },
        "title": {
          "type": "string",
          "maxLength": 16
        },
        "body": {
          "type": "string",
          "minLength": 20,
          "maxLength": 180
        },
        "imageKey": {
          "$ref": "#/$defs/assetKey"
        },
        "quiz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "q",
            "options",
            "answer",
            "explain"
          ],
          "properties": {
            "q": {
              "type": "string",
              "maxLength": 40
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string",
                "maxLength": 14
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "explain": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        "xp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "draft",
                "ai-checked",
                "reviewed",
                "owner-claim"
              ],
              "description": "上线门：只有 reviewed（官方）/ owner-claim（用户真藏）可上线"
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "images",
        "spots",
        "collect"
      ],
      "description": "① 核心最小集：id + name + ≥1 张图 + ≥1 个门道点 + collect；cards 可为空（全部门道都引用领域知识时）",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "origin": {
          "enum": [
            "official",
            "user"
          ],
          "default": "official"
        },
        "name": {
          "type": "string",
          "maxLength": 16
        },
        "subtitle": {
          "type": "string",
          "maxLength": 24
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 8
          }
        },
        "attrs": {
          "type": "object",
          "description": "② 按 全局+大类+领域 字段字典填写的规格值；校验由 check.mjs 按字典完成",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ]
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "spots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/spot"
          }
        },
        "cards": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "collect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keySpots"
          ],
          "properties": {
            "keySpots": {
              "oneOf": [
                {
                  "const": "all"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              ]
            }
          }
        },
        "care": {
          "type": "object",
          "description": "③ 预留模块 care（养：多状态图层 + 演化时间条件）。需 modules 含 care 且引擎具备『离线天数』能力后才消费；形状待该模块立项时定稿"
        },
        "tier": {
          "type": "string",
          "maxLength": 4,
          "description": "品级 = 按品相维度规则计算：各维度档位归一化后取平均 × (品级数−1)，四舍五入取档。这里填写的值必须与计算结果一致（校验器强制），养护改变维度后运行时同样按此规则重算"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "sections",
            "review"
          ],
          "description": "档案卡（owner 2026-09-28）：每件藏品像一张卡片，除了照片与门道点，还有简介、来历、类比、对比、冷知识、挑法等。官方藏品必填",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 20,
              "maxLength": 120
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/profileSection"
              }
            },
            "review": {
              "$ref": "#/$defs/card/properties/review"
            }
          }
        },
        "listed": {
          "type": "boolean",
          "default": true,
          "description": "能否出现在市集在售列表"
        },
        "acquire": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "market",
              "newbie",
              "exam"
            ]
          },
          "default": [
            "market"
          ],
          "description": "获得途径：market 市集购买 · newbie 新手礼 · exam 考级奖品"
        }
      }
    },
    "profileSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title"
      ],
      "description": "档案段落。kind 闭集，每种 kind 需要的字段由 check.mjs 按类型校验",
      "properties": {
        "kind": {
          "enum": [
            "history",
            "analogy",
            "compare",
            "trivia",
            "story",
            "pick",
            "care-tip",
            "related"
          ],
          "description": "history 来历（body 或 timeline）· analogy 类比 · compare 对比（with + points）· trivia 冷知识 · story 轶事 · pick 挑法 · care-tip 养护小窍门 · related 相关（refs）"
        },
        "title": {
          "type": "string",
          "maxLength": 16
        },
        "body": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
        },
        "timeline": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "text"
            ],
            "properties": {
              "when": {
                "type": "string",
                "maxLength": 12,
                "description": "年份或年代，如 1855 / 1950 年代 / 清代"
              },
              "text": {
                "type": "string",
                "maxLength": 60
              }
            }
          }
        },
        "with": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$",
          "description": "对比对象：同爱好藏品 id，或跨爱好「爱好id/藏品id」"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aspect",
              "self",
              "other"
            ],
            "properties": {
              "aspect": {
                "type": "string",
                "maxLength": 8
              },
              "self": {
                "type": "string",
                "maxLength": 30
              },
              "other": {
                "type": "string",
                "maxLength": 30
              }
            }
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "x-specVersion": "1.0"
}
