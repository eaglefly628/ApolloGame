// GD-A 验收剧本 ⑥ · 逻辑·抗贡（G3）：应贡方合计持双大王 → 免贡·头游先出。
// 规则依据 gdd §2.3 G3：抗贡成功则本盘无进贡记录，且由上盘头游先出（非进贡者）。
//   seed=0 首盘打完后，次盘应贡方手握双大王 → 触发抗贡：resisted=true、tribute_count=0、
//   首出=上盘头游(west)。彩头「抗贡成功 +1 倍」在结算时体现（本剧本只钉抗贡触发与免贡口径）。
// 对抗目标（改坏被测逻辑应变红）：
//   · 抗贡判定失效（双大王仍强制进贡）→ tribute_count=1、resisted=false 红。
//   · 抗贡后首出给错人（给进贡者而非头游）→ turn 断言红。
//   · 双大王阈值算错（单王即免/需三王）→ resisted 红。
{
  "name": "抗贡·双大王免贡·头游先出（G3）",
  "game": "game-a",
  "seed": 0,
  "steps": [
    {
      // 首盘无进贡（G4）。
      "expect": [
        { "res": "round", "eq": 1 },
        { "sv": "phase", "eq": "playing" },
        { "flag": "resisted", "eq": false },
        { "res": "tribute_count", "eq": 0 },
      ],
    },
    { "signal": "play-round" },
    { "expect": [{ "flag": "settled", "eq": true }] },
    { "signal": "next-round" }, // 次盘：应贡方持双大王 → 抗贡
    {
      // 抗贡成立：本盘无进贡记录、resisted 置位、上盘头游(west)先出。
      "expect": [
        { "res": "round", "eq": 2 },
        { "sv": "phase", "eq": "playing" },
        { "flag": "resisted", "eq": true },
        { "res": "tribute_count", "eq": 0 }, // 免贡：零进贡记录
        { "sv": "turn", "eq": "west" },      // 头游先出（非进贡者）
        { "flag": "turn_is_hero", "eq": false },
      ],
    },
  ],
}
