// GD-A 验收剧本 ① · 一整局打到头游判定与结算（含进贡/还贡口径）。
// 规则依据 gdd §2.4 结算 + §2.3 进贡/还贡（G1 单下）+ R3 头游升级。
//   seed=16 首盘主角(hero·team0)先出，全自动打完一盘 → 主角头游、combo=一三(first-third·队友居第3)。
//   结算口径（gdd §4 盘结算 + R3）：一三 baseMult=2 → 本盘每人收付=底注100×2=200；
//     头游队(0)升级 +2 → 级数 2→4；对方(1)停 2。
//   次盘进贡（gdd §2.3 G1 单下）：上盘末游(west·排名第4)向头游(hero)进 1 张**最大牌**——
//     此局最大=大王(码16)；头游还 1 张 **≤10**（实测=码2）。进贡者先出 → 次盘 leader=west。
// 对抗目标（改坏被测逻辑应变红）：
//   · 结算倍率/收付算错（如一三给成×3）→ result_total_mult / result_pay 变红。
//   · 头游升级步长错（一三给 +3 或 +1）→ level_ours 变红。
//   · 进贡取非最大牌 / 还贡 >10 / 进还方向反 → tribute0_* 变红。
//   · 盘不收束（死循环）→ play-round 后 phase 仍 playing → settled 断言红。
// ⚠ 种子重选（PE 2026-07-18·AI 策略改良「不拆炸+保留大牌」改变确定性出牌线·旧 seed=7 结算态变）：
//   改 seed=16 重新命中「主角头游·单下进贡·进大王」——结算/进贡口径分支真被走到（值随新出牌线更新·非弱化）。详 requests A-013。
{
  "name": "一盘打到结算·头游判定·进贡还贡口径",
  "game": "game-a",
  "seed": 16,
  "steps": [
    {
      // 开局态：首盘主角先出、无进贡、两队皆 2 级、108 张在场。
      "expect": [
        { "sv": "phase", "eq": "playing" },
        { "sv": "turn", "eq": "hero" },
        { "flag": "turn_is_hero", "eq": true },
        { "res": "round", "eq": 1 },
        { "res": "level_ours", "eq": 2 },
        { "res": "level_theirs", "eq": 2 },
        { "res": "hand_sum", "eq": 108 },
        { "res": "hand_hero", "eq": 27 },
        { "res": "tribute_count", "eq": 0 },
      ],
    },
    { "signal": "play-round" }, // 全自动打完这一盘
    {
      // 盘结算：主角(hero)头游、combo=一三；倍率/收付/升级按 gdd §4+R3。
      "expect": [
        { "flag": "settled", "eq": true },
        { "sv": "phase", "eq": "settled" },
        { "flag": "has_result", "eq": true },
        { "sv": "winner", "eq": "hero" },
        { "res": "winners_team", "eq": 0 },
        { "sv": "combo", "eq": "first-third" },
        { "res": "result_total_mult", "eq": 2 }, // 一三 baseMult=2（无抗贡/无天王炸彩头）
        { "res": "result_pay", "eq": 200 },      // 底注100 × 倍率2
        { "res": "result_level_up", "eq": 2 },   // 一三升 +2（PE 修 A-009 派生 bug 后回收断言）
        { "res": "level_ours", "eq": 4 },        // 我方 2→4（与 result_level_up 交叉印证）
        { "res": "level_theirs", "eq": 2 },      // 对方停 2
        { "res": "hand_hero", "eq": 0 },         // 头游手牌出光
      ],
    },
    { "signal": "next-round" }, // 重开次盘 → 触发进贡/还贡结算
    {
      // 进贡口径（G1 单下）：末游 west → 头游 hero，进最大牌(大王16)、还 ≤10(码2)，进贡者先出。
      "expect": [
        { "res": "round", "eq": 2 },
        { "sv": "phase", "eq": "playing" },
        { "res": "tribute_count", "eq": 1 },
        { "sv": "tribute0_from", "eq": "west" },
        { "sv": "tribute0_to", "eq": "hero" },
        { "res": "tribute0_card", "eq": 16 },    // 进 1 张最大牌=大王
        { "res": "tribute0_return", "eq": 2 },   // 还贡实测=码2
        { "res": "tribute0_return", "lte": 10 }, // 还贡口径：≤10
        { "sv": "turn", "eq": "west" },          // 进贡者先出
        { "flag": "resisted", "eq": false },
      ],
    },
  ],
}
