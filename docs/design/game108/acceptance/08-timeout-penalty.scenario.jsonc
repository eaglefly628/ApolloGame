// GD-108 验收剧本 ⑧ · **T2 超时罚血**（gdd §15 表第 9/10/11 行·验 R-108-04 + R-108-02 v3）。
//   **本条替换 v2 的「超时顺延」**（那条已作废：v2 是「不罚玩家、不卡节奏」，v3 是「罚，而且卡到你出手」）。
//   ① 免费 5 秒内提交 → 零罚血；② 拖过免费段 → 每 1 秒欠 1 点；③ 出手即停；
//   ④ 全程不点也**不会有人替玩家提交**（v2 的顺延已删）。
// 对抗目标（改坏应变红）：
//   · 罚血周期写成"每 2 秒"→ 欠债断言红（会是 2 不是 4）。
//   · 免费段少于 5 秒 → 第一段「零罚血」断言红。
//   · 顺延规则回流 → 第 ④ 段的「没有 DuelIntent」断言红（会被替玩家挂上）。
//   · 罚血不停 → 出手后欠债还在涨 → 第 ③ 段断言红。
{
  "name": "T2 超时罚血·免费段不罚·出手即停·不替玩家提交",
  "game": "game108", "seed": 108,
  "steps": [
    // ── ① 免费段内提交 → 零罚血 ───────────────────────────────────────
    { "tick": 152 },
    { "expect": [ { "sv": "flow", "eq": "throw" }, { "res": "p1.debt", "eq": 0 } ] },
    { "tick": 180 },                       // 在 T2 第 3 秒出手（免费段是 5 秒）
    { "signal": "throw.paper" }, { "tick": 3 },
    { "tick": 300 }, { "tick": 92 },
    { "expect": [
      { "sv": "flow", "eq": "settle" },
      { "res": "p1.debt", "eq": 0 },       // 【R-108-04】免费段内一点都不罚
      { "res": "p1.hp", "eq": 100 },       // 血量只按战果变
      { "res": "p2.hp", "eq": 90 },        // 布克石·布槽 0 → 10
    ] },
    { "signal": "duel.next" }, { "tick": 3 },

    // ── ② 拖过免费段 → 每 1 秒欠 1 点 ─────────────────────────────────
    { "tick": 152 },
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },
    { "tick": 300 },                       // 免费 5 秒烧完
    { "expect": [ { "sv": "flow", "eq": "throwPenalty" }, { "res": "p1.debt", "eq": 0 } ] },
    { "tick": 240 },                       // 再拖 4 秒
    { "expect": [
      { "res": "p1.debt", "eq": 4 },       // 【R-108-04】每 1 秒 1 点（owner 定值）
      // 罚血**不是战果**：没人赢这一回合，流程仍卡在 T2 的读秒尾巴上
      { "res": "p2.hp", "eq": 90 },
      // ④ 【R-108-02】v3：**没有人替玩家提交**（v2 的顺延已删）——
      //    顺延若还在，免费段一到点它就替玩家挂上 intent，流程当场进对决、罚血一点都收不到。
      //    所以「还停在读秒尾巴上」这一条就是"没人替你出手"的机读证据（比断言组件缺失更结实：
      //    runner 没有"该组件不存在"这种断言，而"不存在"和"没跑到"看起来一样）。
      { "sv": "flow", "eq": "throwPenalty" },
    ] },
    { "tick": 240 },
    { "expect": [
      { "res": "p1.debt", "eq": 8 },       // 再拖 4 秒 = 再欠 4 点（一直罚到出手为止）
      { "sv": "flow", "eq": "throwPenalty" },
    ] },

    // ── ③ 出手即停 ───────────────────────────────────────────────────
    { "signal": "throw.paper" }, { "tick": 5 },
    { "expect": [ { "sv": "flow", "eq": "clash" }, { "res": "p1.debt", "eq": 8 } ] },
    { "tick": 120 },
    { "expect": [ { "res": "p1.debt", "eq": 8 } ] },   // 出手之后一点都不再涨
  ],
}
