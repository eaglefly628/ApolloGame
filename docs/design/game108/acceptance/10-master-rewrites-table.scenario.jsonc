// GD-108 验收剧本 ⑩ · 大师自带改写过的判定表（gdd §15 表第 6 行同形状·验 R-108-32/40）。
//   Boss 的判定表被 patch 改过：**石同时克剪与布**。所以对他出布不再稳赢——
//   条款原话「Boss 强在规则，不强在血条」（双方一律 100）。
// 对抗目标：patches 不生效（大师用的还是标准表）→ 掉血的会变成对手 → 断言红。
{
  "name": "大师改表·石反克布",
  "game": "game108", "seed": 108,
  "config": { "opponent": "master" },
  "steps": [
    { "tick": 182 },   // 182 而非 180：从 0 起跳时 after 门要多一拍才落
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },
    { "signal": "throw.paper" },              // 标准表里布克石；大师表里石克布
    { "tick": 360 },
    { "expect": [
      { "res": "p1.hp", "eq": 90 },           // **玩家挨打**——规则被改写了
      { "res": "p2.hp", "eq": 100 },
    ] },
  ],
}
