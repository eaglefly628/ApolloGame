// GD-108 验收剧本 ⑧ · 超时顺延（gdd §15 表第 10 行·验 R-108-02）。
//   第 1 回合玩家出布；第 2 回合**一下都不点**，到点应当自动"保持上一回合的选择"=再出布。
//   条款原话：不罚玩家、不卡节奏。所以顺延不是惩罚，是替玩家把上次的选择再提交一遍。
// 对抗目标：顺延规则撤掉 → 第 2 回合玩家没 intent → 永不结算 → 血量断言红。
{
  "name": "超时顺延·不点也保持上一回合的选择",
  "game": "game108", "seed": 108,
  "steps": [
    // 第 1 回合：正常出布（复读机出石 → 布克石）
    { "tick": 180 },
    { "signal": "throw.paper" },
    { "tick": 360 },
    { "expect": [ { "res": "p2.hp", "eq": 90 }, { "sv": "p1.lastThrow", "eq": "paper" } ] },

    // 第 2 回合：**玩家一下都不点**，只等
    { "tick": 240 },
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },
    { "tick": 5 },
    { "expect": [
      // 【R-108-02】顺延已替玩家提交了上一回合那只手
      { "comp": { "entity": "p1", "component": "DuelIntent", "field": "throw" }, "eq": "paper" },
    ] },
    { "tick": 360 },
    { "expect": [
      { "res": "p2.hp", "eq": 80 },            // 又赢一回合（顺延没罚血、流程没卡）
      { "res": "p1.hp", "eq": 100 },
    ] },
  ],
}
