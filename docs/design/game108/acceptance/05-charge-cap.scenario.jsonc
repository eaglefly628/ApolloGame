// GD-108 验收剧本 ⑤ · 上限锁（gdd §15 表第 7 行·验 R-108-10）**v3 重写**。
//   石槽攒满 3（**三个回合**）后，第 4 个回合再点，**世界侧也不涨**——
//   不是只有 UI 灰着（UI 那一半由 game108.test.ts 的闭集断言 + S3 点击探针把关）。
// 对抗目标：把 Resource.max 拆掉 / op 改成不钳位 → 第 4 回合后断言红（会是 4）。
//   把额度改成"每回合发 3 份"（v2 bug 回流）→ 第 1 回合末的 `eq 1` 当场红。
{
  "name": "上限锁·满 3 后再点不越界",
  "game": "game108", "seed": 108,
  "steps": [
    { "signal": "charge.rock" }, { "tick": 2 },
    { "signal": "charge.rock" }, { "tick": 2 },   // 同回合再点 = 加 0【R-108-10】v3
    { "expect": [ { "res": "p1.charge.rock", "eq": 1 } ] },
    { "tick": 275 },
    { "signal": "throw.scissors" }, { "signal": "throw.paper", "by": "p2" }, { "tick": 3 },
    { "tick": 300 }, { "tick": 92 }, { "signal": "duel.next" }, { "tick": 3 },

    { "signal": "charge.rock" }, { "tick": 2 }, { "tick": 275 },
    { "signal": "throw.scissors" }, { "signal": "throw.paper", "by": "p2" }, { "tick": 3 },
    { "tick": 300 }, { "tick": 92 }, { "signal": "duel.next" }, { "tick": 3 },

    { "signal": "charge.rock" }, { "tick": 2 },
    { "expect": [ { "res": "p1.charge.rock", "eq": 3 } ] },
    { "tick": 275 },
    { "signal": "throw.scissors" }, { "signal": "throw.paper", "by": "p2" }, { "tick": 3 },
    { "tick": 300 }, { "tick": 92 }, { "signal": "duel.next" }, { "tick": 3 },

    // 第 4 回合：已满 3，额度照发但加不上去（Resource.max 钳位）
    { "signal": "charge.rock" }, { "tick": 2 },
    { "signal": "charge.rock" }, { "tick": 2 },
    { "expect": [
      { "res": "p1.charge.rock", "eq": 3 },   // 【R-108-10】封顶 3·多点无效也不报错
      { "sv": "flow", "eq": "charge" },
    ] },
  ],
}
