// GD-108 验收剧本 ⑪ · **T1 超时 = 这回合没蓄力**（gdd §15 表第 8 行·验 R-108-02 v3）。
//   T1 全程不点 → 六条槽一格都不涨、**不罚血**（罚血只在 T2）、正常进 T2。
//   v2 的「顺延上一回合的选择」在 T1 这一侧同样作废：没点就是没点。
// 对抗目标：顺延规则回流 → 我方槽会莫名涨一层 → 断言红；
//   罚血门开错时区（T1 也罚）→ `p1.debt` 断言红。
{
  "name": "T1 超时·一格都不涨也不罚血",
  "game": "game108", "seed": 108,
  "steps": [
    { "expect": [ { "res": "p1.charge.rock", "eq": 0 }, { "res": "p1.budget", "eq": 1 } ] },
    { "tick": 152 },                        // T1 2.5 秒整段不点
    { "expect": [
      { "sv": "flow", "eq": "throw" },      // 正常进 T2
      { "res": "p1.charge.rock", "eq": 0 }, // 六条槽一格没涨
      { "res": "p1.charge.paper", "eq": 0 },
      { "res": "p1.charge.scissors", "eq": 0 },
      { "res": "p1.debt", "eq": 0 },        // T1 不罚血（罚血只在 T2 免费段之后）
      { "res": "p1.budget", "eq": 0 },      // 【R-108-01】额度在进 T2 那一拍作废
    ] },
    // 进了 T2 再点蓄力也没用（额度已作废·不靠禁用按钮）
    { "signal": "charge.rock" }, { "tick": 3 },
    { "expect": [ { "res": "p1.charge.rock", "eq": 0 } ] },
  ],
}
