// GD-108 验收剧本 ② · 诈唬（gdd §15 表第 2 行·验 R-108-11/14）。
//   蓄石 ×3 却出剪，对手出布 → 剪克布，伤害只有 10（剪槽没蓄）；**石槽仍是 3**（没出不清零）。
//   这条守的是本作的支点：蓄力是公开信息，但它**会说谎**——不清零才让下一回合的威胁继续成立。
// 对抗目标：清零清成「所有手」→ 石槽断言红；伤害按石槽算 → p2.hp 断言红（会是 60 不是 90）。
{
  "name": "诈唬·蓄石出剪，石槽不清零",
  "game": "game108", "seed": 108,
  "steps": [
    { "signal": "charge.rock" }, { "tick": 2 },
    { "signal": "charge.rock" }, { "tick": 2 },
    { "signal": "charge.rock" }, { "tick": 2 },
    { "expect": [ { "res": "p1.charge.rock", "eq": 3 } ] },
    { "tick": 180 },
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },
    { "signal": "throw.scissors" },
    { "signal": "throw.paper", "by": "p2" },
    { "tick": 300 },
    { "expect": [
      { "sv": "flow", "eq": "settle" },
      { "res": "p2.hp", "eq": 90 },           // 【R-108-13】剪槽 0 → 10 + 0×10 = 10
      { "res": "p1.charge.rock", "eq": 3 },   // 【R-108-11/14】没出的手原样保留 = 诈唬支点
      { "res": "p1.charge.scissors", "eq": 0 },
      { "sv": "p1.lastThrow", "eq": "scissors" },
    ] },
  ],
}
