// GD-108 验收剧本 ⑦ · **一整局打到终局**（S4 核心循环：开局 → 行动 → 反馈 → 终局）**v3 重写**。
//   对手①复读机永远出石；玩家每回合蓄一层布（布克石）→ 每回合打 10+1×10 = 20。
//   五回合 100 ⇒ 对手倒下，flow 进 p1win。**每回合都得点「下一轮」**（【R-108-05】玩家闸门）。
//   这条是「这游戏到底能不能玩完」的机器证——不是单点规则，是**整条循环**。
//
// ⚠ v2 这条写的是「三回合满蓄布打死」——那正是在断言 R-108-10 的 bug（一个 T1 连点三次直接满蓄）。
//   v3 一回合一层，同样的打法要五回合；这个"变慢"本身就是条款生效的证据。
// 对抗目标（改坏应变红）：
//   · 胜负判定撤掉（self-rule → dead flag 那条按侧通路）→ flow 永远停在 settle → 断言红。
//   · AI 不出招 → 永不结算 → 血不掉 → 断言红。
//   · T4 闸门撤成自动推进 → 中间那条「不点就停在 settle」断言红。
{
  "name": "整局闭环·五回合各蓄一层布打死复读机",
  "game": "game108", "seed": 108,
  "steps": [
    { "expect": [ { "res": "p2.hp", "eq": 100 }, { "sv": "flow", "eq": "charge" } ] },

    // ── 第 1 回合 ──────────────────────────────────────────────────────
    { "signal": "charge.paper" }, { "tick": 2 },
    { "expect": [ { "res": "p1.charge.paper", "eq": 1 } ] },
    { "tick": 275 },
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },
    { "signal": "throw.paper" }, { "tick": 3 },
    { "tick": 300 }, { "tick": 92 },
    { "expect": [
      { "sv": "flow", "eq": "settle" },
      { "res": "p2.hp", "eq": 80 },             // 【R-108-13】10+1×10=20
      { "res": "p1.hp", "eq": 100 },
      { "res": "p1.charge.paper", "eq": 0 },    // 【R-108-14】出过即清零
      { "sv": "p2.lastThrow", "eq": "rock" },   // 复读机出的石（下回合还出石）
    ] },
    // 【R-108-05】不点就不走：干等 10 秒仍停在结算
    { "tick": 600 },
    { "expect": [ { "sv": "flow", "eq": "settle" } ] },
    { "signal": "duel.next" }, { "tick": 3 },
    { "expect": [ { "sv": "flow", "eq": "charge" } ] },

    // ── 第 2-5 回合：同一套 ─────────────────────────────────────────────
    { "signal": "charge.paper" }, { "tick": 2 }, { "tick": 275 },
    { "signal": "throw.paper" }, { "tick": 3 }, { "tick": 300 }, { "tick": 92 },
    { "expect": [ { "res": "p2.hp", "eq": 60 } ] },
    { "signal": "duel.next" }, { "tick": 3 },

    { "signal": "charge.paper" }, { "tick": 2 }, { "tick": 275 },
    { "signal": "throw.paper" }, { "tick": 3 }, { "tick": 300 }, { "tick": 92 },
    { "expect": [ { "res": "p2.hp", "eq": 40 } ] },
    { "signal": "duel.next" }, { "tick": 3 },

    { "signal": "charge.paper" }, { "tick": 2 }, { "tick": 275 },
    { "signal": "throw.paper" }, { "tick": 3 }, { "tick": 300 }, { "tick": 92 },
    { "expect": [ { "res": "p2.hp", "eq": 20 } ] },
    { "signal": "duel.next" }, { "tick": 3 },

    { "signal": "charge.paper" }, { "tick": 2 }, { "tick": 275 },
    { "signal": "throw.paper" }, { "tick": 3 }, { "tick": 300 }, { "tick": 92 },
    { "expect": [
      { "res": "p2.hp", "eq": 0 },              // 【R-108-15】血量归零
      { "flag": "p2.dead", "eq": true },        // 按侧判定（self-rule 读自身 → 各侧唯一旗）
      { "sv": "flow", "eq": "p1win" },          // **终局**：流程收束到胜利态（不等玩家点闸门）
    ] },
  ],
}
