// GD-108 验收剧本 ① · 蓄力与伤害（gdd §15 表第 3 行·验 R-108-10/12/13/14）**v3 重写**。
//   攒到石槽 2（**要两个回合**·v3 一回合只能叠一层）→ 出石，对手出剪 → 石克剪，
//   伤害 = 10 + 2×10 = 30；石槽归 0、布剪槽不动。
//
// ⚠ **v2 这条是反面教材**（gdd §15 写法铁律的第一个受害者）：原文写成「同一个 T1 里 `charge.rock` ×2 → −30」，
//   描述的是"按几次键"——而"按两次加两层"在**「一回合一层」和「每点一次一层」两种实现下都成立**，
//   于是 R-108-10 的漂移躲过了三个阶段。v3 改成**按回合计**：第二层必须跨一个回合才拿得到。
//
// 对抗目标（改坏被测逻辑应变红）：
//   · 伤害不按出手方蓄力缩放（perSide 失效退化成 base）→ p2.hp 断言红（会是 90 不是 70）。
//   · 清零清错侧 / 连没出的手一起清 → charge 断言红。
//   · 克制表写反 → 掉血的会是 p1。
//   · **一回合能叠两层**（v2 的 bug 回流）→ 第一回合的 `p1.charge.rock eq 1` 当场红。
// **时序断言（R-108-01 v3）**：T2 出招是「同时提交·全程隐藏」，扣血写在 **T4 结算**那一拍，
//   所以出招当下血量**不该**变——这条是照条款写的，不是照实现写的。
{
  "name": "蓄力与伤害·两回合攒到 2 层出石克剪掉 30",
  "game": "game108",
  "seed": 108,
  "steps": [
    { "expect": [
      { "sv": "flow", "eq": "charge" },
      { "res": "p1.hp", "eq": 100 },
      { "res": "p2.hp", "eq": 100 },
      { "res": "p1.charge.rock", "eq": 0 },
    ] },

    // ── 第 1 回合：T1 点石 ×3 —— 【R-108-10】v3 只涨一层 ────────────────────
    { "signal": "charge.rock" }, { "tick": 2 },
    { "signal": "charge.rock" }, { "tick": 2 },
    { "signal": "charge.rock" }, { "tick": 2 },
    { "expect": [
      { "res": "p1.charge.rock", "eq": 1 },   // 点三次 = 一层（不是 3）
      { "res": "p1.charge.paper", "eq": 0 },
      { "sv": "flow", "eq": "charge" },
    ] },

    // 走完 T1 的 2.5 秒 → 进 T2 出招时区
    { "tick": 275 },
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },

    // 第 1 回合出剪（不出石 ⇒ 石那一层留着·【R-108-14】只清出过的手）；对手复读机出石 → 石克剪，我挨打
    { "signal": "throw.scissors" }, { "tick": 3 },
    { "expect": [
      { "sv": "flow", "eq": "throwLag" },     // 【R-108-01】v4：出手即离开免费段，落进定拍
      { "res": "p1.hp", "eq": 100 },          // 【R-108-01】扣血在 T4，出招当下不该掉
    ] },
    { "tick": 35 },   // 【R-108-01】v4：出手即走——定拍半秒（30 拍·after 门多一拍）→ 对决
    { "expect": [ { "sv": "flow", "eq": "clash" }, { "res": "p1.debt", "eq": 0 } ] },
    { "tick": 92 },
    { "expect": [
      { "sv": "flow", "eq": "settle" },
      { "res": "p1.charge.rock", "eq": 1 },   // 石没出过 → 保留
      { "res": "p1.charge.scissors", "eq": 0 },
    ] },

    // ── 【R-108-05】T4 玩家闸门：点「下一轮」才进第 2 回合 ─────────────────
    { "signal": "duel.next" }, { "tick": 3 },
    { "expect": [ { "sv": "flow", "eq": "charge" }, { "res": "p1.budget", "eq": 1 } ] },

    // ── 第 2 回合：再点一次石 → 攒到 2 层 ──────────────────────────────────
    { "signal": "charge.rock" }, { "tick": 2 },
    { "expect": [ { "res": "p1.charge.rock", "eq": 2 } ] },
    { "tick": 275 },
    { "expect": [ { "sv": "flow", "eq": "throw" } ] },

    // T2：双方同时提交
    { "signal": "throw.rock" },
    { "signal": "throw.scissors", "by": "p2" },
    { "tick": 3 },
    { "expect": [
      // 【R-108-01】v4：出手当拍就离开免费段，落进**定拍**（半秒·揭晓前手还扣着）。
      { "sv": "flow", "eq": "throwLag" },
      { "res": "p1.charge.rock", "eq": 2 },   // 清零在 T4
    ] },
    { "tick": 35 },
    { "expect": [ { "sv": "flow", "eq": "clash" } ] },
    { "tick": 92 },
    { "expect": [
      { "sv": "flow", "eq": "settle" },
      { "res": "p2.hp", "eq": 70 },           // 【R-108-13】10 + 2×10 = 30
      { "res": "p1.charge.rock", "eq": 0 },   // 【R-108-14】出过即清零
      { "res": "p1.charge.paper", "eq": 0 },
      { "sv": "p1.lastThrow", "eq": "rock" }, // 【R-108-30】记本回合的手
      { "sv": "p2.lastThrow", "eq": "scissors" },
    ] },
  ],
}
