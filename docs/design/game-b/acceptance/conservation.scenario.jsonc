// 查的规则：四家点数零和守恒。
//   起点：四家各 50000 → Σ=200000（gdd §四 起点行「⚙ 50000 点」）。
//   无马无 oka·纯点数 1:1（gdd §四 马/oka 行「v1 无马无 oka」）——所以点数只在四家之间转移，
//   全程不凭空生/灭点；终局把残供托归第 1 位后（gdd §四 供托归属行），台面点数仍应 Σ=200000。
// 规则依据：gdd §四 起点=50000×4=200000；无马无 oka；终局残供托归第 1 位（棒也来自点数，回收后守恒）。
// 对抗目标（一个理解错规则的程序员会犯的错，这些键能照出来）：
//   · 用了标准 25000 而非本作「初始多给」的 50000 → 起始 score_0..3 直接照出。
//   · 和牌"凭空造点"（winner 加分但 loser 未等额扣分）→ 终局 score_sum > 200000。
//   · 残供托丢失/不回收给第 1 位 → 终局 score_sum < 200000 且 kyotaku > 0。
//   · 误加了马/oka（顺位补偿）→ 终局 score_sum ≠ 200000。
{
  "name": "点数零和守恒",
  "game": "game-b",
  "seed": 20260717,
  "config": { "seatNames": ["主角", "绫", "莉世", "小夜"] },
  "steps": [
    {
      // 开局态（发牌后·未行动）：四家各 50000，供托 0，未终局。
      "expect": [
        { "res": "score_sum", "eq": 200000 },
        { "res": "score_0", "eq": 50000 },
        { "res": "score_1", "eq": 50000 },
        { "res": "score_2", "eq": 50000 },
        { "res": "score_3", "eq": 50000 },
        { "res": "kyotaku", "eq": 0 },
        { "flag": "over", "eq": false }
      ]
    },
    { "signal": "play-match" },
    {
      // 终局态：整场结束、残供托已归第 1 位、点数守恒回到 200000。
      "expect": [
        { "flag": "over", "eq": true },
        { "res": "score_sum", "eq": 200000 },
        { "res": "kyotaku", "eq": 0 }
      ]
    }
  ]
}
