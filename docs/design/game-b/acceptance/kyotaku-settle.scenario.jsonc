// 查的规则：供托（立直棒）来源守恒 + 终局结算归第 1 位。
//   立直棒 1000 从立直者点数扣出、置于台面成供托（gdd §四「立直棒/本场棒 1000/300」）——
//     故立直棒是点数的搬移，不是新增；kyotaku ≥ 0（不得重复回收成负）。
//   流局立直棒滚存下局（gdd §四 供托归属），终局残供托归第 1 位 →
//     over 后 kyotaku 必 = 0，且 score_sum 守恒回 200000（棒不丢不增，守恒兜底）。
//   开局无人行动：kyotaku=0、无人立直。
// 规则依据：gdd §四 立直棒 1000；供托归属（流局滚存·终局残供托归第 1 位）；点数守恒（立直棒来自点数）。
// 对抗目标：
//   · 终局忘记把残供托发给第 1 位 → over 后 kyotaku > 0（且 score_sum < 200000）照出。
//   · 立直棒重复回收/记账错（发两次、或扣了没入台面）→ kyotaku < 0 或 score_sum ≠ 200000 照出。
//   · 开局误置立直棒/本场棒非零 → 开局 kyotaku ≠ 0 或 riichi_* 为 true 照出。
{
  "name": "供托结算与立直棒守恒",
  "game": "game-b",
  "seed": 31415,
  "config": { "seatNames": ["主角", "绫", "莉世", "小夜"] },
  "steps": [
    {
      // 开局：台面无供托、四家均未立直。
      "expect": [
        { "res": "kyotaku", "eq": 0 },
        { "flag": "riichi_0", "eq": false },
        { "flag": "riichi_1", "eq": false },
        { "flag": "riichi_2", "eq": false },
        { "flag": "riichi_3", "eq": false }
      ]
    },
    { "signal": "play-match" },
    {
      // 终局：残供托必已归第 1 位（台面清零），点数守恒兜底 → 立直棒既没丢也没凭空增。
      "expect": [
        { "flag": "over", "eq": true },
        { "res": "kyotaku", "eq": 0 },
        { "res": "score_sum", "eq": 200000 }
      ]
    }
  ]
}
