// 查的规则：主角豁免脱衣 + 衣物数值边界 + 单局脱衣幅度上限。
//   ⚖ 主角不脱（gdd §三「主角不脱…脱衣状态仅三姨太持有」、§七「主角豁免·不脱只扣分」）：
//     无论主角是否被直击（放铳/被自摸），hero_clothing 恒 = 5。
//   三姨太各 5 件，脱光(0)不再脱（gdd §七）→ 每家 clothing ∈ [0,5]，只减不增。
//   开局 clothing_sum = 主角5 + 三姨太各5 = 20。
//   单局脱衣上限 = 3：一局只有一个和了/流局结果；被自摸时另三家付（主角豁免），
//     最坏是主角自摸→三姨太各脱 1 = 3 件；放铳(荣和)最多脱放铳者 1 件；流局/立直棒不脱。
//     故一局(play-round)后 clothing_sum ≥ 20-3 = 17。
// 规则依据：gdd §三/§七 主角豁免、姨太 5 件、脱光不再脱、立直棒/罚符非直击不触发脱衣、被自摸三家各脱。
// 对抗目标：
//   · 给主角也脱（symmetric 默认应 false）→ hero_clothing < 5 照出。
//   · 脱衣越界成负数、或错误"回穿"超过 5 → clothing_1..3 边界照出。
//   · 把立直棒失点/听牌罚符也当直击脱衣、或一次直击脱多件 → 单局 clothing_sum < 17 照出。
{
  "name": "主角豁免脱衣与衣物边界",
  "game": "game-b",
  "seed": 424242,
  "config": { "seatNames": ["主角", "绫", "莉世", "小夜"] },
  "steps": [
    {
      // 开局：主角 5、三姨太各 5、合计 20。
      "expect": [
        { "res": "hero_clothing", "eq": 5 },
        { "res": "clothing_1", "eq": 5 },
        { "res": "clothing_2", "eq": 5 },
        { "res": "clothing_3", "eq": 5 },
        { "res": "clothing_sum", "eq": 20 }
      ]
    },
    { "signal": "play-round" },
    {
      // 打完一局：主角仍 5；每姨太 ∈ [0,5]；单局至多脱 3 件 → 合计 ≥ 17。
      "expect": [
        { "res": "hero_clothing", "eq": 5 },
        { "res": "clothing_1", "gte": 0 },
        { "res": "clothing_1", "lte": 5 },
        { "res": "clothing_2", "gte": 0 },
        { "res": "clothing_2", "lte": 5 },
        { "res": "clothing_3", "gte": 0 },
        { "res": "clothing_3", "lte": 5 },
        { "res": "clothing_sum", "gte": 17 },
        { "res": "clothing_sum", "lte": 20 }
      ]
    },
    { "signal": "play-match" },
    {
      // 打穿整场：主角始终 5；姨太可脱到 0 但不越界；合计 ∈ [5,20]（下限=只剩主角的 5）。
      "expect": [
        { "res": "hero_clothing", "eq": 5 },
        { "res": "clothing_1", "gte": 0 },
        { "res": "clothing_1", "lte": 5 },
        { "res": "clothing_2", "gte": 0 },
        { "res": "clothing_2", "lte": 5 },
        { "res": "clothing_3", "gte": 0 },
        { "res": "clothing_3", "lte": 5 },
        { "res": "clothing_sum", "gte": 5 },
        { "res": "clothing_sum", "lte": 20 }
      ]
    }
  ]
}
