.subtitle {
  font-size: 30rpx;
  color: #e74c3c;
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}

.pathogen-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  width: 100%;
  margin-bottom: 40rpx;
  gap: 16rpx;
}

.pathogen-card {
  width: 320rpx;
  padding: 24rpx;
  background: #222244;
  border: 2rpx solid #333;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pathogen-card.selected {
  border-color: #e74c3c;
  background: #2a1a2e;
  box-shadow: 0 0 20rpx rgba(231, 76, 60, 0.3);
}

.pathogen-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.pathogen-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #eee;
}

.pathogen-origin {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.pathogen-desc {
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
}

.divider {
  display: flex;
  align-items: center;
  width: 80%;
  margin: 20rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #444;
}

.divider-text {
  color: #666;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.status-text {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #e74c3c;
}
