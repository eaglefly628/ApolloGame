<view class="container">
  <text class="title">内卷公司</text>
  <text class="subtitle">大厂龙虾的蔓延</text>

  <!-- 病原体选择 -->
  <view class="pathogen-grid">
    <view
      wx:for="{{pathogens}}"
      wx:key="type"
      class="pathogen-card {{selectedPathogen === item.type ? 'selected' : ''}}"
      bindtap="onSelectPathogen"
      data-type="{{item.type}}"
    >
      <text class="pathogen-icon">{{item.icon}}</text>
      <text class="pathogen-name">{{item.name}}</text>
      <text class="pathogen-origin">{{item.origin}}</text>
      <text class="pathogen-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="btn-primary" bindtap="onSoloStart">单人模式</view>

  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">或</text>
    <view class="divider-line"></view>
  </view>

  <view class="btn-secondary" bindtap="onQuickMatch">快速匹配</view>
  <view class="btn-secondary" bindtap="onCreateRoom">创建房间</view>
  <view class="btn-secondary" bindtap="onJoinRoom">加入房间</view>

  <view wx:if="{{statusText}}" class="status-text">{{statusText}}</view>
</view>
