.game-info {
  font-size: 32rpx;
  color: #ccc;
  margin-bottom: 40rpx;
}

.board {
  display: flex;
  flex-wrap: wrap;
  width: 480rpx;
  height: 480rpx;
}

.cell {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #444;
  box-sizing: border-box;
}

.cell-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #667eea;
}

.cell.filled .cell-text {
  color: #e0a0ff;
}

.result-panel {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 40rpx;
}
