<view class="game-container">
  <!-- Top HUD -->
  <view class="hud-top">
    <view class="hud-item">
      <text class="hud-label">DAY</text>
      <text class="hud-value">{{day}}</text>
    </view>
    <view class="hud-item kpi">
      <text class="hud-label">KPI</text>
      <text class="hud-value">{{kpiPoints}}</text>
    </view>
    <view class="hud-item">
      <text class="hud-label">感染</text>
      <text class="hud-value">{{infectedCount}}</text>
    </view>
    <view class="hud-item">
      <text class="hud-label">离职</text>
      <text class="hud-value">{{removedCount}}</text>
    </view>
  </view>

  <!-- Cure Progress Bar -->
  <view class="cure-bar-wrap">
    <text class="cure-label">躺平思潮: {{cureProgress}}%</text>
    <view class="cure-bar-bg">
      <view class="cure-bar-fill" style="width: {{cureProgress}}%"></view>
    </view>
  </view>

  <!-- World Map Canvas -->
  <canvas canvas-id="worldMap" class="world-canvas" bindtap="onMapTap"></canvas>

  <!-- Region Info Popup -->
  <view wx:if="{{selectedRegion}}" class="region-popup">
    <text class="region-name">{{selectedRegion.name}}</text>
    <text class="region-stat">健康: {{selectedRegion.susceptible}} / 感染: {{selectedRegion.infected}} / 离职: {{selectedRegion.removed}}</text>
    <view wx:if="{{gamePhase === 'seeding' && !selectedRegion.isDiscovered}}" class="btn-small" bindtap="onSeedRegion">
      在此投放病原体
    </view>
  </view>

  <!-- Event Popup -->
  <view wx:if="{{activeEvent}}" class="event-popup">
    <text class="event-title">{{activeEvent.name}}</text>
    <text class="event-desc">{{activeEvent.desc}}</text>
    <view class="event-actions">
      <view wx:if="{{activeEvent.templateId === 'labor_arbitration'}}" class="btn-small danger" bindtap="onDismissEvent">
        驳回! ({{dismissClicks}}/{{activeEvent.requiredClicks}})
      </view>
      <view wx:elif="{{activeEvent.templateId === 'refund_riot'}}" class="event-btn-row">
        <view class="btn-small danger" bindtap="onSuppressRiot">封号反击 ({{activeEvent.kpiCost}} KPI)</view>
        <view class="btn-small" bindtap="onIgnoreRiot">忽略</view>
      </view>
    </view>
  </view>

  <!-- Bottom Controls -->
  <view class="controls-bottom">
    <view class="ctrl-btn" bindtap="onTogglePause">{{isPaused ? '▶' : '⏸'}}</view>
    <view class="ctrl-btn" bindtap="onOpenTree">OKR</view>
    <view wx:if="{{specialAbility}}" class="ctrl-btn special" bindtap="onUseSpecial">
      {{specialAbility.name}}
    </view>
    <view wx:if="{{gamePhase === 'seeding'}}" class="ctrl-btn start" bindtap="onStartSim">
      开始蔓延
    </view>
  </view>
</view>
