page {
  background-color: #1a1a2e;
  color: #eee;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.btn-primary {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
  margin: 20rpx 0;
}

.btn-secondary {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: transparent;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 48rpx;
  font-size: 34rpx;
  margin: 20rpx 0;
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 60rpx;
}
