{
  "name": "game114-crowd-avoidance-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:navigation && npm run verify:stress",
    "verify:navigation": "vite-node --config vite.config.mjs demo/verify-navigation.ts",
    "verify:stress": "vite-node --config vite.config.mjs demo/verify-stress.ts",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.184.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-node": "^2.1.9",
    "vitest": "^2.0.5"
  }
}
