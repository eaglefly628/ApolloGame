{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎨 ZeroCraft 工作台 (Workshop)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/zerocraft.py",
      "args": [
        "workshop"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "ZeroCraft 创作台 (player mode)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/zerocraft.py",
      "args": [
        "player"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Cartridge (menu)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_game.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Cartridge: game-g",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_game.py",
      "args": [
        "game-g"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Cartridge: ALL games",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_game.py",
      "args": [
        "all"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Preview Cartridge",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/preview_cartridge.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Build + Preview: game-g",
      "configurations": [
        "Build Cartridge: game-g",
        "Preview Cartridge"
      ],
      "stopAll": true
    }
  ]
}
